NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (Next.js dev server)
CORS_ORIGINS=http://localhost:3000

# Runtime connection: RLS-bound role, NOT the table owner
DATABASE_URL=postgres://simpleride_app:app_dev_password@localhost:5432/simpleride
# Migration/seed connection: table owner
DATABASE_OWNER_URL=postgres://simpleride_owner:owner_dev_password@localhost:5432/simpleride

REDIS_URL=redis://localhost:6379

# openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Admin/staff sessions last this long, then they must log in again
BACKOFFICE_SESSION_TTL_HOURS=12

# SMS codes are not used for login right now (phone + password). Kept for
# future phone verification.
OTP_TTL_SECONDS=300
OTP_DEV_ECHO=true

# Gebeta Maps (https://gebeta.app) — get a key from the Gebeta dashboard
GEBETA_API_KEY=
GEBETA_BASE_URL=https://mapapi.gebeta.app

# Seeded admin (db:seed)
SEED_ADMIN_PHONE=+251900000000
