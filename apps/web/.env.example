# Server-side only: where the Next.js BFF reaches the Express API
API_URL=http://localhost:4000

# Browser: Socket.IO endpoint for live trip updates
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Browser: MapLibre style for Gebeta vector tiles (from the Gebeta dashboard;
# use a domain-restricted key). Leave empty to fall back to an OSM demo style.
NEXT_PUBLIC_GEBETA_STYLE_URL=
