# Server-side only: where the Next.js BFF reaches the Express API
API_URL=http://localhost:4000

# Browser: Socket.IO endpoint for live trip updates
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Browser: Gebeta key for map tiles (sent as a Bearer header to tiles.gebeta.app).
# It is visible to site visitors — restrict it to your domain in the Gebeta
# dashboard. Leave empty to fall back to an OpenStreetMap demo style.
NEXT_PUBLIC_GEBETA_TILES_KEY=
